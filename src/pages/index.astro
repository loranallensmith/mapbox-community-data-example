---
import Layout from "../layouts/Layout.astro";
import ProjectArt from "../components/ProjectArt.astro";
import { sourceStatus } from "../lib/channels";
import { projects } from "../lib/projects";
import data from "../../data/processed/ecosystem.json";
import channels from "../../data/processed/channels.json";
import { href, date } from "../lib/site";
const issues = data.repositories.reduce(
    (n, r) => n + r.metrics.issuesOpened,
    0,
  ),
  prs = data.repositories.reduce((n, r) => n + r.metrics.prsOpened, 0);
const featured = [...data.repositories]
  .sort(
    (a, b) =>
      b.metrics.issuesOpened +
      b.metrics.prsOpened -
      (a.metrics.issuesOpened + a.metrics.prsOpened),
  )
  .slice(0, 4);
---

<Layout title="Overview">
  <div class="portal-intro">
    <div>
      <div class="eyebrow">Projects + public ecosystem data</div>
      <h1>Mapbox in practice.</h1>
      <p>
        Try the tools. Explore repository activity. Find community-created
        resources.
      </p>
    </div>
    <div class="actions">
      <a class="button" href={href("projects")}>
        Browse projects ↗
      </a>
      <a class="button secondary" href={href("sources")}>
        View data sources
      </a>
    </div>
  </div>
  <div class="stats">
    <div>
      <span>Repositories tracked</span>
      <strong>{data.repositories.length}</strong>
      <small>
        {data.repositories.filter((r) => r.archived).length} archived ·
        explicitly selected
      </small>
    </div>
    <div>
      <span>Issues opened</span>
      <strong>{issues}</strong>
      <small>GitHub · {data.window.days}-day window</small>
    </div>
    <div>
      <span>Pull requests opened</span>
      <strong>{prs}</strong>
      <small>Includes automated activity</small>
    </div>
    <div>
      <span>Community resources</span>
      <strong>{channels.items.length}</strong>
      <small>Collected links · not total ecosystem size</small>
    </div>
  </div>
  <div class="portal-grid">
    <div>
      <section>
        <div class="section-head">
          <h2>Try a project</h2>
          <a class="text-link" href={href("projects")}>
            All projects →
          </a>
        </div>
        <div class="two">
          {projects.map((p) => (
            <article class="card project-card">
              <a href={href(p.slug)} aria-label={`Open ${p.name}`}>
                <ProjectArt type={p.art} />
              </a>
              <div class="project-body">
                <span class="badge">{p.library}</span>
                <h3>{p.name}</h3>
                <p>{p.description}</p>
                <div class="project-tags">
                  {p.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </div>
                <a class="text-link" href={href(p.slug)}>
                  Launch demo ↗
                </a>
                <span class="muted" style="display:block;margin-top:8px">
                  {p.status}
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="card">
        <div class="section-head">
          <h2>Community resources</h2>
          <a class="text-link" href={href("community")}>
            Browse content →
          </a>
        </div>
        {channels.items.length ? (
          <div class="compact-list">
            {channels.items.slice(0, 4).map((item) => (
              <div class="compact-row">
                <div>
                  <a href={item.url}>{item.title} ↗</a>
                  <small>
                    {item.publisher} · {item.kind} · affiliation unverified
                  </small>
                </div>
                <span class="badge gray">{item.sourceId}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="muted">
            No resources collected yet. Add feeds, curated links, or a YouTube
            API key in source configuration.
          </p>
        )}
      </section>
    </div>
    <div>
      <section class="card">
        <div class="section-head">
          <h2>Repository activity</h2>
          <a class="text-link" href={href("ecosystem")}>
            Details →
          </a>
        </div>
        <p class="metric-note">
          New issues + PRs · {date(data.window.start)}–{date(data.window.end)}
        </p>
        <div class="compact-list">
          {featured.map((r) => (
            <div class="compact-row">
              <span class="repo-icon" aria-hidden="true">
                ⌘
              </span>
              <div class="repo-info">
                <a href={r.url}>{r.name.split("/")[1]} ↗</a>
                <small>
                  {r.metrics.issuesOpened} issues · {r.metrics.prsOpened} PRs
                </small>
              </div>
              <div class="compact-stat">
                <strong>{r.metrics.issuesOpened + r.metrics.prsOpened}</strong>
                <small>items</small>
              </div>
            </div>
          ))}
        </div>
        <a
          class="text-link"
          href={href("ecosystem")}
          style="display:block;margin-top:15px"
        >
          Compare all {data.repositories.length} repositories →
        </a>
      </section>
      <section class="card">
        <div class="section-head">
          <h2>Source coverage</h2>
          <a class="text-link" href={href("sources")}>
            Configure →
          </a>
        </div>
        {channels.sources.map((s) => (
          <div class="source-tile">
            <div>
              <h3 class="source-name">
                {s.id === "articles" ? "Published articles" : s.id}
              </h3>
              <p>
                {s.type === "github"
                  ? `${data.repositories.length} tracked repositories`
                  : `${s.itemCount} resource links`}
              </p>
            </div>
            <span
              class={`badge ${["collected", "imported"].includes(s.status) ? "green" : "gray"}`}
            >
              {sourceStatus(s)}
            </span>
          </div>
        ))}
      </section>
      <a
        class="card"
        href={href("opportunities")}
        style="display:block;text-decoration:none"
      >
        <span class="badge">Evidence → experiments</span>
        <h3>Opportunities to test ↗</h3>
        <p style="margin:0">
          Specific developer questions, interventions, and success measures.
        </p>
      </a>
    </div>
  </div>
  <p class="meta">
    GitHub collected {date(data.collectedAt)}. Source windows and freshness
    differ; see Data sources. Metrics are observations, not community-health
    scores.
  </p>
</Layout>
