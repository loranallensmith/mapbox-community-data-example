---
import Layout from "../layouts/Layout.astro";
import ProjectArt from "../components/ProjectArt.astro";
import { projects } from "../lib/projects";
import { href } from "../lib/site";
---

<Layout title="Projects">
  <div class="page-intro">
    <div class="eyebrow">Hands-on examples</div>
    <h1>Projects</h1>
    <p class="lead">
      Working examples of Mapbox ecosystem tools. Launch a demo or inspect the
      library behind it.
    </p>
  </div>
  <div class="two">
    {projects.map((p) => (
      <article class="card project-card">
        <a href={href(p.slug)} aria-label={`Open ${p.name}`}>
          <ProjectArt type={p.art} />
        </a>
        <div class="project-body">
          <span class="badge">{p.library}</span>
          <h2>{p.name}</h2>
          <p>{p.description}</p>
          <div class="project-tags">
            {p.tags.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <p class="muted">{p.status}</p>
          <div class="actions">
            <a class="button" href={href(p.slug)}>
              Launch demo ↗
            </a>
            <a class="text-link" href={p.source}>
              Library source ↗
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="notice">
    These examples demonstrate library capabilities. The geographic dataset is
    historical; the image comparison starts with a clearly labeled synthetic
    sample. Neither is evidence of a production deployment or community outcome.
  </div>
</Layout>
