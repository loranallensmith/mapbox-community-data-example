---
import Layout from "../layouts/Layout.astro";
import data from "../../data/processed/ecosystem.json";
import { href, hours, date } from "../lib/site";
const totals = data.repositories.reduce(
  (n, r) => ({
    issues: n.issues + r.metrics.issuesOpened,
    prs: n.prs + r.metrics.prsOpened,
    closed: n.closed + r.metrics.closedPrs,
  }),
  { issues: 0, prs: 0, closed: 0 },
);
---

<Layout title="GitHub activity">
  <div class="portal-intro">
    <div>
      <div class="eyebrow">Public GitHub data</div>
      <h1>GitHub activity</h1>
      <p>
        {date(data.window.start)}–{date(data.window.end)} · {data.window.days}{" "}
        days · collected {date(data.collectedAt)}
      </p>
    </div>
    <div class="actions">
      <a class="button secondary" href={href("sources")}>
        Change repositories
      </a>
      <a class="text-link" href={href("data/github.json")}>
        Download evidence ↗
      </a>
    </div>
  </div>
  <div class="stats">
    <div>
      <span>Tracked repositories</span>
      <strong>{data.repositories.length}</strong>
      <small>
        {data.repositories.filter((r) => r.archived).length} archived
      </small>
    </div>
    <div>
      <span>New issues</span>
      <strong>{totals.issues}</strong>
      <small>Created in this window</small>
    </div>
    <div>
      <span>New pull requests</span>
      <strong>{totals.prs}</strong>
      <small>Includes automation</small>
    </div>
    <div>
      <span>Closed PRs in cohort</span>
      <strong>{totals.closed}</strong>
      <small>Closed by window end · not acceptance</small>
    </div>
  </div>
  <div class="content-controls">
    <label>
      Find a repository
      <input id="repo-query" type="search" placeholder="Repository name" />
    </label>
    <label>
      Repository status
      <select id="repo-status" aria-label="Repository status">
        <option value="all">All repositories</option>
        <option value="active">Unarchived</option>
        <option value="archived">Archived</option>
      </select>
    </label>
    <span class="muted" id="repo-count" role="status" aria-live="polite">
      {data.repositories.length} repositories
    </span>
  </div>
  <section class="table-wrap">
    <table>
      <caption>
        Activity and response indicators. Duration and response measurements are
        proxies; see definitions below.
      </caption>
      <thead>
        <tr>
          <th scope="col">Repository</th>
          <th scope="col">Issues</th>
          <th scope="col">PRs</th>
          <th scope="col">Median PR closure</th>
          <th scope="col">Median sampled response</th>
        </tr>
      </thead>
      <tbody>
        {data.repositories.map((r) => (
          <tr
            class="repo-row"
            data-name={r.name.toLowerCase()}
            data-archived={String(r.archived)}
          >
            <th scope="row">
              <a href={r.url}>{r.name} ↗</a>
              <small style="display:block;font-weight:400;margin-top:5px">
                {r.archived ? "Archived" : "Unarchived"} · last push{" "}
                {date(r.pushedAt)}
              </small>
            </th>
            <td>{r.metrics.issuesOpened}</td>
            <td>{r.metrics.prsOpened}</td>
            <td>
              {hours(r.metrics.medianPrCloseHours)}
              <small>
                {r.metrics.closedPrs} closed of {r.metrics.prsOpened} opened
              </small>
            </td>
            <td>
              {hours(r.metrics.medianSampleResponseHours)}
              <small>
                {r.metrics.respondedSample}/{r.metrics.responseSampleSize}{" "}
                sampled issues responded
              </small>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  <p id="repo-empty" class="notice" hidden>
    No repositories match these filters.
  </p>
  <details>
    <summary>How to read these metrics</summary>
    <p>
      Issue and PR counts include all authors and automation. PR closure
      includes both merged and unmerged requests; open PRs are excluded from the
      median. Response times use only the newest bounded issue sample, exclude
      author/Bot comments, and exclude unanswered items from the median.
      Unavailable means no eligible observations, not a zero-hour response.
    </p>
    <p>
      GL JS documents internal import and Copybara sync: accepted public PRs can
      appear closed rather than merged. Closure cannot be interpreted as
      rejection. These measurements are not health scores or maintainer
      evaluations.
    </p>
    <a class="text-link" href={href("methodology")}>
      CHAOSS definitions, bias, and reproducibility →
    </a>
  </details>
  <section style="margin-top:28px">
    <div class="section-head">
      <h2>Repository details</h2>
      <span class="muted">Purpose, licensing, contribution entry points</span>
    </div>
    {data.repositories.map((r) => (
      <details>
        <summary>
          {r.name} · {r.archived ? "Archived" : "Unarchived"} · {r.license}
        </summary>
        <p>{r.description}</p>
        <div class="actions">
          {r.docs.CONTRIBUTING[0] ? (
            <a
              class="text-link"
              href={`${r.url}/blob/${r.branch}/${r.docs.CONTRIBUTING[0]}`}
            >
              Contribution guide ↗
            </a>
          ) : (
            <a class="text-link" href={`${r.url}#readme`}>
              README contribution entry ↗
            </a>
          )}
          {r.docs.LICENSE[0] && (
            <a
              class="text-link"
              href={`${r.url}/blob/${r.branch}/${r.docs.LICENSE[0]}`}
            >
              License ↗
            </a>
          )}
        </div>
        <p class="muted">
          CONTRIBUTING:{" "}
          {r.docs.CONTRIBUTING.length ? "file found" : "no named file found"} ·
          SUPPORT:{" "}
          {r.docs.SUPPORT.length ? "file found" : "no named file found"} ·
          CODE_OF_CONDUCT:{" "}
          {r.docs.CODE_OF_CONDUCT.length ? "file found" : "no named file found"}{" "}
          · tree truncated: {String(r.treeTruncated)}. Organization defaults and
          README guidance may exist.
        </p>
        {r.license === "NOASSERTION" && (
          <p class="muted">
            GitHub did not assign a standard SPDX license. Read the license
            terms at source; public visibility does not imply an open-source
            license.
          </p>
        )}
      </details>
    ))}
  </section>
  {data.candidates.length > 0 && (
    <details>
      <summary>
        Unavailable repository candidates ({data.candidates.length})
      </summary>
      {(data.candidates as { name: string; status: string }[]).map((c) => (
        <p>
          {c.name}: {c.status}
        </p>
      ))}
    </details>
  )}
  <p class="muted">
    One window, no longitudinal trend. Contributors, review-cycle duration,
    private support, and developer satisfaction are not measured.
  </p>
</Layout>
<script>
  const query = document.querySelector<HTMLInputElement>("#repo-query")!,
    status = document.querySelector<HTMLSelectElement>("#repo-status")!,
    rows = [...document.querySelectorAll<HTMLTableRowElement>(".repo-row")];
  function filter() {
    let count = 0;
    for (const row of rows) {
      const visible =
        row.dataset.name!.includes(query.value.toLowerCase().trim()) &&
        (status.value === "all" ||
          (status.value === "archived") === (row.dataset.archived === "true"));
      row.hidden = !visible;
      if (visible) count++;
    }
    document.querySelector("#repo-count")!.textContent =
      `${count} repositories`;
    document.querySelector<HTMLElement>("#repo-empty")!.hidden = count > 0;
  }
  query.addEventListener("input", filter);
  status.addEventListener("change", filter);
</script>
