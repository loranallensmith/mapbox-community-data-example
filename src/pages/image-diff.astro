---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Visual Difference Lab">
  <div class="page-intro">
    <div class="eyebrow">Project / pixelmatch</div>
    <h1>Visual Difference Lab</h1>
    <p class="lead">
      See how Mapbox’s pixelmatch library detects image changes. Everything runs
      locally in your browser.
    </p>
    <p class="muted">
      Starts with a synthetic UI sample, not a map render or production
      screenshot. Upload two PNG/JPEG images of the same dimensions to compare
      your own work. Images are never uploaded.
    </p>
  </div>
  <section class="card">
    <div class="lab-controls">
      <label>
        Difference threshold <span id="threshold-value">0.10</span>
        <input
          type="range"
          id="threshold"
          min="0"
          max="1"
          step="0.01"
          value="0.1"
        />
      </label>
      <label>
        Original image
        <input type="file" id="original-file" accept="image/png,image/jpeg" />
      </label>
      <label>
        Changed image
        <input type="file" id="changed-file" accept="image/png,image/jpeg" />
      </label>
      <button id="reset-images" type="button">
        Reset sample
      </button>
    </div>
    <div class="canvas-grid">
      <div>
        <label>Original</label>
        <canvas
          id="original"
          width="480"
          height="320"
          aria-label="Original image preview"
        ></canvas>
      </div>
      <div>
        <label>Changed</label>
        <canvas
          id="changed"
          width="480"
          height="320"
          aria-label="Changed image preview"
        ></canvas>
      </div>
      <div>
        <label>Pixel difference</label>
        <canvas
          id="difference"
          width="480"
          height="320"
          aria-label="Pixel difference image"
        ></canvas>
      </div>
    </div>
    <div
      id="diff-result"
      class="lab-result"
      role="status"
      aria-live="polite"
    ></div>
    <p id="diff-error" class="notice" role="alert" hidden></p>
  </section>
  <div class="two">
    <section class="card">
      <h3>What this measures</h3>
      <p>
        Pixels that differ under pixelmatch’s perceptual color threshold, with
        its default anti-aliasing exclusion. The percentage uses the full image
        area. Higher thresholds tolerate larger color differences.
      </p>
      <a class="text-link" href="https://github.com/mapbox/pixelmatch">
        pixelmatch implementation & license ↗
      </a>
    </section>
    <section class="card">
      <h3>Try it</h3>
      <p>
        Move the threshold, inspect highlighted differences, then compare two
        screenshots. Inputs must have identical dimensions and be no larger than
        four million pixels or 10 MB per file.
      </p>
      <p class="muted">
        A pixel difference detects visual change; it does not determine whether
        the change is a bug.
      </p>
    </section>
  </div>
</Layout>
<script>
  import pixelmatch from "pixelmatch";
  const original = document.querySelector<HTMLCanvasElement>("#original")!,
    changed = document.querySelector<HTMLCanvasElement>("#changed")!,
    difference = document.querySelector<HTMLCanvasElement>("#difference")!;
  const threshold = document.querySelector<HTMLInputElement>("#threshold")!,
    result = document.querySelector<HTMLElement>("#diff-result")!,
    error = document.querySelector<HTMLElement>("#diff-error")!;
  const inputs = [
    document.querySelector<HTMLInputElement>("#original-file")!,
    document.querySelector<HTMLInputElement>("#changed-file")!,
  ];
  function compare() {
    error.hidden = true;
    const width = original.width,
      height = original.height;
    if (width !== changed.width || height !== changed.height) {
      error.textContent =
        "Both images must have identical dimensions. Upload the matching image or reset the sample.";
      error.hidden = false;
      result.textContent = "Comparison unavailable: image dimensions differ.";
      return;
    }
    difference.width = width;
    difference.height = height;
    const a = original.getContext("2d")!.getImageData(0, 0, width, height),
      b = changed.getContext("2d")!.getImageData(0, 0, width, height),
      out = difference.getContext("2d")!.createImageData(width, height);
    const count = pixelmatch(a.data, b.data, out.data, width, height, {
      threshold: Number(threshold.value),
    });
    difference.getContext("2d")!.putImageData(out, 0, 0);
    result.replaceChildren();
    const number = document.createElement("strong");
    number.textContent = `${((count / (width * height)) * 100).toFixed(2)}%`;
    const text = document.createElement("p");
    text.textContent = `${count.toLocaleString()} differing pixels / ${(width * height).toLocaleString()} total · ${width} × ${height}`;
    result.append(number, text);
  }
  function reset() {
    for (const [i, canvas] of [original, changed].entries()) {
      canvas.width = 480;
      canvas.height = 320;
      const ctx = canvas.getContext("2d")!;
      ctx.fillStyle = "#f1f5fa";
      ctx.fillRect(0, 0, 480, 320);
      ctx.fillStyle = "#193958";
      ctx.fillRect(24, 24, 432, 44);
      ctx.fillStyle = "#fff";
      ctx.font = "bold 16px sans-serif";
      ctx.fillText("Synthetic dashboard sample", 40, 52);
      ctx.fillStyle = "#fff";
      ctx.fillRect(24, 90, 432, 205);
      ctx.fillStyle = i ? "#3682d9" : "#3275bd";
      ctx.fillRect(45, i ? 127 : 115, i ? 265 : 250, 28);
      for (let row = 0; row < 3; row++) {
        ctx.fillStyle = "#dae5f2";
        ctx.fillRect(45, 175 + row * 30, 340, 10);
      }
      ctx.fillStyle = "#56bca4";
      ctx.fillRect(i ? 350 : 330, 115, 60, 40);
    }
    for (const input of inputs) input.value = "";
    compare();
  }
  threshold.addEventListener("input", () => {
    document.querySelector("#threshold-value")!.textContent = Number(
      threshold.value,
    ).toFixed(2);
    compare();
  });
  document.querySelector("#reset-images")!.addEventListener("click", reset);
  for (const [index, input] of inputs.entries())
    input.addEventListener("change", async () => {
      const file = input.files?.[0];
      if (!file) return;
      try {
        if (
          !["image/png", "image/jpeg"].includes(file.type) ||
          file.size > 10e6
        )
          throw new Error("Choose a PNG/JPEG smaller than 10 MB.");
        const image = await createImageBitmap(file);
        if (image.width * image.height > 4e6) {
          image.close();
          throw new Error(
            "Choose an image no larger than four million pixels.",
          );
        }
        const canvas = index ? changed : original;
        canvas.width = image.width;
        canvas.height = image.height;
        canvas.getContext("2d")!.drawImage(image, 0, 0);
        image.close();
        compare();
      } catch (e) {
        error.textContent =
          e instanceof Error ? e.message : "Image could not be read.";
        error.hidden = false;
      }
    });
  reset();
</script>
