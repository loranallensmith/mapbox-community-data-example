    "research:collect": "node scripts/research/collect.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.4.5",
    "mapbox-gl": "^3.16.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
