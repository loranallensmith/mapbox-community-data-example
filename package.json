{
  "name": "mapbox-ecosystem-field-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-data.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
