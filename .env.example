PUBLIC_MAPBOX_TOKEN=pk.your_public_token
# Optional build-time repository link after publishing:
PUBLIC_REPO_URL=
# Optional collector authentication. Never prefix this with PUBLIC_.
GITHUB_TOKEN=
# GitHub Pages project sites: /repository-name
BASE_PATH=/
SITE_URL=https://your-account.github.io
# Optional build-time YouTube collector key. Enable YouTube Data API v3.
# Restrict the key to that API; do not prefix it with PUBLIC_.
YOUTUBE_API_KEY=
